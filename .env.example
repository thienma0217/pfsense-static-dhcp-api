SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now

PFSENSE_URL=https://192.0.2.1/
PFSENSE_USER=admin
PFSENSE_PASS=change-me
# PFSENSE_ROUTER=pfsense    # must match the entry's hostname in routers.yml, if you use that file
# PFSENSE_INTERFACE=opt2    # override to match your DHCP interface

# comma-separated key:cidr:label triples, one static-IP pool per key
STATIC_IP_RANGES=office:192.0.2.0/28:Office,cctv:192.0.2.16/28:CCTV

# optional - without these, invite links are shown on screen instead of emailed
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
